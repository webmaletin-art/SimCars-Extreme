; SimCars Extreme (Godot 4.7.2, GL Compatibility). La escena principal es el cliente liviano (bootstrap): si el juego ya está adentro, arranca directo.
config_version=5

[application]

config/name="SimCars Extreme"
run/main_scene="res://bootstrap/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://store/icon_192.png"
boot_splash/bg_color=Color(0.03, 0.045, 0.07, 1)

[display]

window/size/viewport_width=1280
window/size/viewport_height=576
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/mode=0
window/handheld/orientation=4

[input_devices]

sensors/enable_accelerometer=true
sensors/enable_gravity=true

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=6

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
environment/defaults/default_clear_color=Color(0.05, 0.07, 0.1, 1)
textures/vram_compression/import_etc2_astc=true

[importer_defaults]

; los .wav se guardan SIN comprimir (los bucles cortos del motor suenan mal comprimidos)
wav={
"compress/mode": 0
}
